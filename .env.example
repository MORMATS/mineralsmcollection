# PostgreSQL en un LXC de Proxmox.
APP_ENV=development

# Cambia IP_DEL_LXC_DB por la IP real del LXC de PostgreSQL.
DATABASE_URL=postgresql+psycopg://isminerals_app:CAMBIA_ESTA_PASSWORD@IP_DEL_LXC_DB:5432/isminerals

# API opcional de Mindat.
MINDAT_API_KEY=

# Contrasena de administracion para Alta/edicion, Admin datos e Importar API.
# Puedes escribirla directamente aqui, por ejemplo: ADMIN_PASSWORD_HASH=mi_contrasena
# Tambien puedes pegar aqui el hash generado por scripts/hash_admin_password.py.
ADMIN_PASSWORD_HASH=

# En produccion usa /var/lib/isminerals/uploads.
UPLOAD_DIR=uploads

# Ejemplo si la app Streamlit corre en el mismo LXC que PostgreSQL:
# DATABASE_URL=postgresql+psycopg://isminerals_app:CAMBIA_ESTA_PASSWORD@localhost:5432/isminerals
