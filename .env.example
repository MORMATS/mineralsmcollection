# PostgreSQL en un LXC de Proxmox.
# Cambia 192.168.1.50 por la IP real del LXC.
DATABASE_URL=postgresql+psycopg://minerales_user:CAMBIA_ESTA_PASSWORD@192.168.1.50:5432/minerales

# API opcional de Mindat.
MINDAT_API_KEY=

# Ejemplo si la app Streamlit corre en el mismo LXC que PostgreSQL:
# DATABASE_URL=postgresql+psycopg://minerales_user:CAMBIA_ESTA_PASSWORD@localhost:5432/minerales
